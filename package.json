{
  "name": "videome",
  "version": "0.1.0",
  "description": "A local-first, AI-assisted video production tool",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.preview.config.js --host 127.0.0.1 --port 4179",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop": "electron .",
    "start": "npm run dev",
    "test": "vitest run",
    "build": "vite build",
    "bundle:media": "npm run media:prepare",
    "dist:mac": "npm run build && node scripts/package.cjs mac",
    "media:prepare": "node scripts/media-prepare.cjs",
    "media:check": "node scripts/media-check.cjs",
    "dist:win": "npm run build && node scripts/package.cjs win",
    "verify:package": "node scripts/verify-package.cjs",
    "acceptance:fixtures": "node scripts/acceptance-fixtures.cjs",
    "diagnostics": "node scripts/diagnostics.cjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.0"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "concurrently": "^9.2.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "studio.videome.local",
    "productName": "Videome",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "media-bin/${platform}-${arch}",
        "to": "media-bin"
      },
      {
        "from": "resources/fonts",
        "to": "fonts"
      },
      {
        "from": "resources/dubbing",
        "to": "dubbing"
      },
      {
        "from": "resources/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "mac": {
      "target": [
        "dir",
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "minimumSystemVersion": "15.0",
      "identity": "-",
      "notarize": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "videome",
        "name": "Videome Project",
        "description": "Videome 视频工程文件",
        "mimeType": "application/x-videome-project",
        "role": "Editor"
      }
    ],
    "asar": true,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-win-${arch}-${target}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
