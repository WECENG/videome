{
  "name": "videome",
  "version": "0.1.0",
  "description": "A local-first, AI-assisted video production tool",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.preview.config.js --host 127.0.0.1 --port 4179",
    "desktop:dev": "concurrently -k 'vite --host 127.0.0.1 --port 5173' 'wait-on http://127.0.0.1:5173 && electron .'",
    "desktop": "electron .",
    "start": "npm run dev",
    "test": "vitest run",
    "build": "vite build",
    "dist:mac": "npm run build && electron-builder --mac dir"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.0"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "concurrently": "^9.2.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "studio.videome.local",
    "productName": "Videome",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      { "from": "/opt/homebrew/opt/ffmpeg/bin/ffmpeg", "to": "media-bin/ffmpeg" },
      { "from": "/opt/homebrew/opt/ffmpeg/bin/ffprobe", "to": "media-bin/ffprobe" }
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.video"
    },
    "fileAssociations": [
      {
        "ext": "videome",
        "name": "Videome Project",
        "description": "Videome 视频工程文件",
        "mimeType": "application/x-videome-project",
        "role": "Editor"
      }
    ],
    "asar": true
  }
}
